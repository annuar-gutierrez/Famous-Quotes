<%- include("partials/header.ejs") %>

<body>
  <br>
    <h1> Quotes Found</h1>
    <a href="/"> Return Home </a>

    <hr>

    <div class="container"></div>
    
    <% for (i of quotes) { %>

        <%= i.quote %> <br>
        -<em>
            <a href="#" class="authorLink" id="<%=i.authorId %>">
                <%=i.firstName%> <%=i.lastName%>
            </a>
        </em>
        <br><br>

    <% } %>

    <!-- Modal -->
<div class="modal fade" id="authorModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Author Information</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="authorInfo"></div>        
      </div>
      <div class="modal-footer">
        <!-- <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary">Save changes</button> -->
      </div>
    </div>
  </div>
</div>

<div id="authorInfo"></div>

    <!-- Button trigger modal -->
<!-- <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
  Launch demo modal
</button> -->

    
  <%- include("partials/footer.ejs") %>
  <script src="/js/scripts.js">
  
  </script>
</body>
</html>