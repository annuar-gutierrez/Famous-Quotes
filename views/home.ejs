<%- include("partials/header.ejs") %>

<body>

    <h1> Quote Finder </h1>

    <form action="/searchByKeyword" method="GET">
        <h2>Keyword :</h2> 
        <input type="text" name="keyword">
        <button>Search by Keyword</button>
    </form>

    <br>

    <form action="/searchByAuthor" method="GET">
        <select name="authorId">
            <h2>Authors: </h2>
            <% for (let i of authors) { %>
                <option value="<%=i.authorId%>">
                    <%=i.firstName%> <%=i.lastName%>
                </option>
            <% } %>

<!--       
            <option value="1">Albert Einstein</option>
            <option value="2">Agatha Christie</option>
            <option value="3">Marie Curie</option>
            <option value="4">Abraham Lincoln</option>
            <option value="5">Mohandas Gandhi</option>
            <option value="6">Helen Keller</option>
            <option value="7">Benjamin Franklin</option> -->

        </select>
        <button>Search by Author</button>
    </form>

    <form action="/searchByCategory" method="GET">
        <select name="category">
            <h2>Category: </h2>
            <% for(let c of categories){ %>
                <option value="<%= c.category %>">
                    <%= c.category %>
                </option>
            <% } %>
            </select>
        </select>
        <button>Search by Category</button>
    </form>

    <form action="/searchByLikes">
        <h2>Likes</h2>
        Min Likes: <input type="number" name="min">
        Max Likes: <input type="number" name="max">
        <button>Search by Likes</button>
    </form>

    <%- include("partials/footer.ejs") %>
</body>
</html>