<%- include("partials/header.ejs") %>

<body>
    <br>
    <h1> Quote Finder </h1>
    <hr>

    <form id="searchByKeywordForm" action="/searchByKeyword" method="GET">
        <h2>Keyword :</h2> 
        <input type="text" name="keyword">
        <button>Search by Keyword</button>
        <small id="errorMsg"></small>
    </form>

    <br>

    <form action="/searchByAuthor" method="GET">
        <h2>Authors: </h2>
        <select name="authorId">
            <% for (let i of authors) { %>
                <option value="<%=i.authorId%>">
                    <%=i.firstName%> <%=i.lastName%>
                </option>
            <% } %>

<!--       
            <option value="1">Albert Einstein</option>
            <option value="2">Agatha Christie</option>
            <option value="3">Marie Curie</option>
            <option value="4">Abraham Lincoln</option>
            <option value="5">Mohandas Gandhi</option>
            <option value="6">Helen Keller</option>
            <option value="7">Benjamin Franklin</option> -->

        </select>
        <button>Search by Author</button>
    </form>

    <br>

    <form action="/searchByCategory" method="GET">
        <h2>Category: </h2>
        <select name="category">
            <% for(let c of categories){ %>
                <option value="<%= c.category %>">
                    <%= c.category %>
                </option>
            <% } %>
            </select>
        </select>
        <button>Search by Category</button>
    </form>

    <br>

    <form action="/searchByLikes" method="GET">
        <h2>Likes</h2>
        <input type="number" name="min" placeholder="Min Likes">
        <input type="number" name="max" placeholder="Max Likes">
        <button>Search by Likes</button>
    </form>

    <%- include("partials/footer.ejs") %>
    <script>
      document.querySelector("#searchByKeywordForm").addEventListener("submit", validateKeywordForm);

      //ensure that keyword has at least 3 characters
      function validateKeywordForm(){
        let keyword = document.querySelector("input[name=keyword]").value;
        let errorMsg = document.querySelector("#errorMsg");

        if (keyword.length < 3) {
        


            event.preventDefault(); //prevents the form submission.
            errorMsg.textContent = "Keyword must be at least 3 characters.";
            // alert("keyword must be at least 3 characters");
            // event.preventDefault(); //prevents the form submission.
        }
        
      }


    </script>
</body>
</html>